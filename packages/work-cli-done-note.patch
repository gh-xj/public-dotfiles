+func TestDoneWorkItemWithoutNoteDoesNotNeedSpace(t *testing.T) {
+	store := newInitializedTestStore(t)
+	item, err := store.CreateWorkItem(WorkItemInput{Title: "Complete without notes"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	spacePath := store.workItemSpacePath(item.ID)
+	if err := os.MkdirAll(filepath.Dir(spacePath), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(spacePath, []byte("blocked space"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	result, err := store.DoneWorkItem(DoneWorkItemInput{ID: item.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Item.Status != WorkStatusDone || result.CompletionPath != "" {
+		t.Fatalf("unexpected done result: %#v", result)
+	}
+}
