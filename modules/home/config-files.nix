{ config, lib, pkgs, publicDotfilesDelivery, ... }:

let
  cfg = config.xj.publicDotfiles;
  operationsTaskfile = cfg.operationsTaskfile;
  inherit (publicDotfilesDelivery)
    mkGeneratedText
    mkImmutableFile
    mkImmutableTree
    mkRepoFile
    mkRepoTree
    ;
in
{
  config = lib.mkIf cfg.enable {
    home.packages = [ (pkgs.writeShellApplication {
      name = "nvim-health";
      runtimeInputs = [ pkgs.python3 ];
      text = ''exec python3 ${../../scripts/nvim-health.py} "$@"'';
    }) ];
    home.file = {
      ".amethyst.yml" = mkRepoFile ".config/amethyst/amethyst.yml";
      "Taskfile.yml" = mkGeneratedText ''
        # Generated: common tasks plus the configured dotfiles owner.
        version: "3"
        includes:
          global:
            taskfile: ${builtins.toJSON "${cfg.repoRoot}/global/Taskfile.yml"}
            flatten: true
          dotfiles:
            taskfile: ${builtins.toJSON operationsTaskfile}
            dir: ${builtins.toJSON (builtins.dirOf operationsTaskfile)}
      '' // { force = true; };
      ".tmux.conf" = mkGeneratedText ''
        # Generated by Home Manager from public-dotfiles. Do not edit.
        source-file ~/.config/tmux/tmux.conf
      '';
      ".local/bin/workmux" = mkGeneratedText ''
        #!/bin/sh
        exec "$HOME/.local/state/nix/profiles/home-manager/home-path/bin/workmux" "$@"
      '' // {
        executable = true;
        force = true;
      };
      ".zshenv" = mkGeneratedText (
        builtins.readFile ../../.zshenv
        + lib.optionalString (cfg.zshEnvExtra != "") ("\n" + cfg.zshEnvExtra)
      ) // { force = true; };
      ".zprofile" = mkRepoFile ".zprofile";
      ".zshrc" = mkRepoFile ".zshrc";
    };

    xdg.configFile = {
      "bat" = mkImmutableTree ".config/bat";
      "amethyst" = mkRepoTree ".config/amethyst";
      "karabiner" = mkRepoTree ".config/karabiner";
      "lazygit" = mkImmutableTree ".config/lazygit";
      "nvim" = mkRepoTree ".config/nvim";
      "opencode" = mkRepoTree ".config/opencode";
      "raycast/scripts" = mkRepoTree ".config/raycast/scripts";
      "xj_public_raycast_scripts" = mkRepoTree ".config/raycast/scripts";
      "starship.toml" = mkImmutableFile ".config/starship.toml";
      "zed/settings.json" = mkRepoFile ".config/zed/settings.json";
      "zed/keymap.json" = mkRepoFile ".config/zed/keymap.json";
      "zed/tasks.json" = mkRepoFile ".config/zed/tasks.json";
      "zed/snippets/markdown.json" = mkRepoFile ".config/zed/snippets/markdown.json";
      "zed/themes/xj-one-theme.json" = mkRepoFile ".config/zed/themes/xj-one-theme.json";
      "yazi" = mkImmutableTree ".config/yazi";
    };
  };
}
