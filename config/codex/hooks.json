{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-workmux-status working"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-workmux-status waiting"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-notify codex permission"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-workmux-status resume"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-workmux-status done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-notify codex done"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-session codex start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-session codex end"
          }
        ]
      }
    ]
  }
}
