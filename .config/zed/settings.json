{
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "use_system_clipboard": "always",
    "toggle_relative_line_numbers": false
  },
  "theme": {"mode": "system", "light": "One Light", "dark": "xj - One Dark"},
  "ui_font_size": 16,
  "buffer_font_family": "Monaspace Argon",
  "buffer_font_size": 16,
  "buffer_line_height": "comfortable",
  "relative_line_numbers": false,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "format_on_save": "off",
  "autosave": {"after_delay": {"milliseconds": 1000}},
  "edit_predictions": {"provider": "none"},
  "diff_view_style": "split",
  "git": {"inline_blame": {"enabled": false}},
  "indent_guides": {"enabled": true, "coloring": "indent_aware"},
  "outline_panel": {"dock": "right", "default_width": 320},
  "active_pane_modifiers": {"border_size": 1},
  "inlay_hints": {"enabled": true},
  "use_system_window_tabs": true,
  "when_closing_with_no_tabs": "keep_window_open",
  "title_bar": {"show_user_picture": false, "show_onboarding_banner": false},
  "telemetry": {"diagnostics": false, "metrics": false},
  "auto_install_extensions": {"nix": true, "toml": true},
  "terminal": {
    "dock": "bottom",
    "font_family": "RecMonoDuotone Nerd Font",
    "font_size": 16,
    "option_as_meta": true,
    "shell": {"program": "/bin/zsh"},
    "env": {"EDITOR": "nvim", "VISUAL": "nvim"}
  },
  "languages": {
    "Go": {"format_on_save": "on", "formatter": {"external": {"command": "gofmt"}}},
    "JSON": {"format_on_save": "on", "formatter": {"external": {"command": "jq", "arguments": [".", "-"]}}},
    "Markdown": {"format_on_save": "off", "tab_size": 2},
    "Python": {"language_servers": ["pyright", "ruff"]}
  }
}
